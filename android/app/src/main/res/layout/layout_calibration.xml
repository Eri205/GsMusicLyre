<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/calibration_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#44000000">

    <!-- Top floating toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_margin="12dp"
        android:background="@drawable/bg_floating_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Kéo 21 vòng tròn vào đúng phím đàn Genshin"
            android:textColor="@color/accent_gold"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_calib_reset"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_card_glass"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="Mặc Định"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btn_calib_save"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_btn_gold"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="✔ LƯU"
            android:textColor="#000000"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_calib_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_card_glass"
            android:text="✖"
            android:textColor="@color/accent_red"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Calibration Key Markers Container -->
    <FrameLayout
        android:id="@+id/markers_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
