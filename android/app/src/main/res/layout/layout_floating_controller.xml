<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/controller_root"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_floating_panel"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Bar: Drag Title + Minimize + Close -->
    <LinearLayout
        android:id="@+id/header_drag_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_float_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="GsMusicLyre Auto"
            android:textColor="@color/accent_gold"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_float_minimize"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:gravity="center"
            android:text="➖"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btn_float_close"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:gravity="center"
            android:text="✖"
            android:textColor="@color/accent_red"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Current Song Name -->
    <TextView
        android:id="@+id/tv_current_song"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Chọn bài để phát..."
        android:textColor="@color/text_primary"
        android:textSize="12sp" />

    <!-- Progress Bar & Time -->
    <ProgressBar
        android:id="@+id/progress_song"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:progress="0"
        android:progressTint="@color/accent_gold" />

    <TextView
        android:id="@+id/tv_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="end"
        android:text="00:00 / 00:00"
        android:textColor="@color/text_secondary"
        android:textSize="10sp" />

    <!-- Playback Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_prev_song"
            android:layout_width="44dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_card_glass"
            android:text="⏮"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_play_pause"
            android:layout_width="70dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_btn_gold"
            android:text="▶ PHÁT"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btn_next_song"
            android:layout_width="44dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_card_glass"
            android:text="⏭"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Speed / Delay / Calibrate Options -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_speed_down"
            android:layout_width="32dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_card_glass"
            android:text="-"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_speed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="1.0x"
            android:textColor="@color/accent_gold"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_speed_up"
            android:layout_width="32dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_card_glass"
            android:text="+"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_toggle_game"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_btn_gradient"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="🎮 Genshin (21)"
            android:textColor="@color/text_primary"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btn_open_calibrate"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_card_glass"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="🎯 Căn Phím"
            android:textColor="@color/accent_gold"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>
